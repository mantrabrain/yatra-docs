# Copy to .env.screenshots (gitignored) and fill in.
# Used by `npm run screenshots`.
YATRA_URL=https://yatra.local
YATRA_USER=admin
YATRA_PASS=replace-me

# Optional: edit an existing trip instead of creating a new one
# YATRA_TRIP_ID=123

# Optional: HEADED=1 to watch the browser for debugging
# HEADED=1
